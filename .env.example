# Environment Variables Template
# Copy this file to .env.local and fill in your values

# Next.js Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CloudCode

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api
API_SECRET_KEY=your-secret-key-here

# Remote Execution Configuration
EXECUTION_TIMEOUT=10000
EXECUTION_MEMORY_LIMIT=268435456
EXECUTION_CPU_LIMIT=1

# Rate Limiting
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=60000

# Database Configuration (for production)
DATABASE_URL=postgresql://user:password@localhost:5432/codeflow

# CDN Configuration (for WASM binaries)
NEXT_PUBLIC_CDN_URL=https://cdn.jsdelivr.net

# Monitoring and Analytics
NEXT_PUBLIC_ANALYTICS_ID=
SENTRY_DSN=

# Feature Flags
NEXT_PUBLIC_ENABLE_REMOTE_EXECUTION=true
NEXT_PUBLIC_ENABLE_COLLABORATION=false
NEXT_PUBLIC_ENABLE_AI_ASSISTANCE=false

# Security
CORS_ORIGIN=http://localhost:3000
CSRF_SECRET=your-csrf-secret-here
